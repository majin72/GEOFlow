# GEO Monitor sidecar + noVNC（Debian bookworm slim）。
# 使用系统 Chromium + PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD，跳过 scrapling install（通常可节省 30–60+ 分钟）。
# 不使用 RUN --mount（兼容未启用 BuildKit 的 ECS 经典构建器）。
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    GEO_MONITOR_CHROMIUM_EXECUTABLE=/usr/bin/chromium \
    GEO_MONITOR_DISPLAY=:99 \
    GEO_MONITOR_NOVNC_BIND=127.0.0.1 \
    GEO_MONITOR_NOVNC_PORT=6080

# Debian apt：阿里云（与 docker/Dockerfile.prod 一致）
RUN set -eux; \
    for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list /etc/apt/sources.list.d/debian.list; do \
        [ -f "$f" ] || continue; \
        sed -i \
            -e 's|https://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g' \
            -e 's|http://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g' \
            -e 's|https://security.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|g' \
            -e 's|http://security.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|g' \
            "$f"; \
    done

RUN apt-get -o Acquire::Retries=3 update && apt-get install -y --no-install-recommends \
    xvfb fluxbox x11vnc novnc websockify \
    chromium \
    fonts-noto-cjk fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-docker.txt ./

# pip：默认阿里云 PyPI（海外构建可在 compose build.args 留空或改官方源）
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}

RUN pip install -r requirements-docker.txt \
    && python -c "import curl_cffi; from scrapling.fetchers import DynamicSession"

COPY geo_monitor_poc ./geo_monitor_poc
COPY scripts ./scripts
COPY run.sh ./

RUN chmod +x scripts/novnc/*.sh scripts/docker/entrypoint-sidecar.sh run.sh 2>/dev/null \
    || chmod +x scripts/novnc/*.sh scripts/docker/entrypoint-sidecar.sh

EXPOSE 6080 8765

CMD ["./scripts/docker/entrypoint-sidecar.sh"]
