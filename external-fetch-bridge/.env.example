# ---------------------------------------------------------------------------
# external-fetch-bridge 配置示例。复制为 .env 后填写实际值。
# 注意：.env 已被 .gitignore（项目根级），切勿把生产 token 提交到仓库。
# ---------------------------------------------------------------------------

# Bridge HTTP 监听
# 本地开发监听 127.0.0.1 即可；生产通过 SSH 反向隧道穿透到服务器 localhost，无需暴露公网
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=19826

# 必填：HTTP Bearer Token。服务端 ExternalFetchService 配置的 external_fetch_token 必须与此一致
# 建议生成方式：openssl rand -hex 32
BRIDGE_TOKEN=

# 必填：Node 24+ 二进制路径（opencli 实测要求 Node >= 21，否则 webidl.util 报错）
# 例：/Users/majin/Library/Application Support/Herd/config/nvm/versions/node/v24.14.1/bin/node
NODE24_BIN=

# 必填：opencli CLI 入口（npm -g 安装产生的 shim 脚本）
# 例：/Users/majin/Library/Application Support/Herd/config/nvm/versions/node/v20.20.0/bin/opencli
# 通过 `which opencli` 或 `command -v opencli` 拿到
OPENCLI_ENTRY=

# 并发限流：避免本地 Chrome 卡死；2 对单机最稳；CPU/内存富裕可调到 3~4
MAX_CONCURRENT=2

# 单次抓取超时（毫秒）。务必小于服务端 timeout（默认 60s）* 1000，留余量给网络往返
FETCH_TIMEOUT_MS=55000
