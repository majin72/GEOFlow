# --- 前端资产构建阶段：与 Dockerfile.prod 保持一致，确保 nginx 静态目录里有 public/build ---
FROM node:22-bookworm-slim AS assets

WORKDIR /app

# Vite 在打包时把 VITE_* 直接内联进 JS 产物；这些值需通过 docker compose build.args 在构建期注入，
# 否则前端 Echo/Pusher 启动时报 "You must pass your app key when you instantiate Pusher"。
ARG VITE_REVERB_APP_KEY=""
ARG VITE_REVERB_HOST=""
ARG VITE_REVERB_PORT=""
ARG VITE_REVERB_SCHEME=""
ARG VITE_REVERB_PATH=""
ENV VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY \
    VITE_REVERB_HOST=$VITE_REVERB_HOST \
    VITE_REVERB_PORT=$VITE_REVERB_PORT \
    VITE_REVERB_SCHEME=$VITE_REVERB_SCHEME \
    VITE_REVERB_PATH=$VITE_REVERB_PATH

# npmmirror 中国镜像加速 npm install
RUN npm config set registry https://registry.npmmirror.com/

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build

FROM nginx:1.31.1-alpine

WORKDIR /var/www/html

# Alpine apk 国内镜像（与 app Dockerfile 阿里云源一致；海外构建可传 --build-arg APK_MIRROR=dl-cdn.alpinelinux.org）
ARG APK_MIRROR=mirrors.aliyun.com
RUN sed -i "s/dl-cdn.alpinelinux.org/${APK_MIRROR}/g" /etc/apk/repositories \
    && apk add --no-cache apache2-utils

COPY public /var/www/html/public
# 用 Vite 构建产物覆盖/补齐宿主机 public/build（宿主机可能没本地构建过）
COPY --from=assets /app/public/build /var/www/html/public/build
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/docker-entrypoint.d/40-geo-monitor-novnc.sh /docker-entrypoint.d/40-geo-monitor-novnc.sh
RUN mkdir -p /etc/nginx/snippets \
    && echo "# GEO monitor noVNC public access disabled" > /etc/nginx/snippets/geo-monitor-novnc-locations.conf

RUN chmod +x /docker-entrypoint.d/40-geo-monitor-novnc.sh \
    && rm -f /var/www/html/public/storage \
    && ln -s ../storage/app/public /var/www/html/public/storage
