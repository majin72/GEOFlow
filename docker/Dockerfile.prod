FROM composer:2 AS vendor

WORKDIR /app

# Alpine 国内源（阿里云）加速 docker-php-ext-install pcntl 所需的 apk 编译工具链（gcc/m4/perl 等）
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories

# Composer 国内镜像（阿里云全量），加速后续 packagist 包下载
RUN composer config -g repo.packagist composer https://mirrors.aliyun.com/composer/

# composer:2 基础镜像未默认启用 pcntl；Horizon 在 install 时会校验 ext-pcntl（运行阶段已安装，此处对齐锁文件平台检查）
RUN docker-php-ext-install pcntl

COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --classmap-authoritative \
    --no-scripts

COPY . .

# .dockerignore 排除了 .env，构建期 Laravel 默认 DB_CONNECTION=sqlite 且路径为 database/database.sqlite；
# AppServiceProvider 注册链会触发 SiteSettingsBag → Schema::hasTable，需存在可连接的空库文件。
RUN mkdir -p database \
    && touch database/database.sqlite

RUN composer dump-autoload \
    --no-dev \
    --no-interaction \
    --classmap-authoritative \
    --no-scripts \
 && BROADCAST_CONNECTION=null php artisan package:discover --ansi

# --- 前端资产构建阶段：编译 Vite 产物到 public/build，供运行时镜像与 nginx 镜像复制 ---
FROM node:22-bookworm-slim AS assets

WORKDIR /app

# Vite 在打包时把 VITE_* 直接内联进 JS 产物；这些值需通过 docker compose build.args 在构建期注入，
# 否则 import.meta.env.VITE_REVERB_APP_KEY 为 undefined，前端 Echo/Pusher 会抛 "You must pass your app key"。
ARG VITE_REVERB_APP_KEY=""
ARG VITE_REVERB_HOST=""
ARG VITE_REVERB_PORT=""
ARG VITE_REVERB_SCHEME=""
ARG VITE_REVERB_PATH=""
ENV VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY \
    VITE_REVERB_HOST=$VITE_REVERB_HOST \
    VITE_REVERB_PORT=$VITE_REVERB_PORT \
    VITE_REVERB_SCHEME=$VITE_REVERB_SCHEME \
    VITE_REVERB_PATH=$VITE_REVERB_PATH

# npmmirror 中国镜像加速 npm install
RUN npm config set registry https://registry.npmmirror.com/

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# 仅拷贝 Vite 构建所需的源文件，减少缓存失效面
COPY resources ./resources
COPY public ./public
COPY vite.config.js ./

RUN npm run build

FROM php:8.4-fpm-bookworm

WORKDIR /var/www/html

RUN set -eux; \
    . /etc/os-release; \
    printf 'Types: deb\nURIs: https://mirrors.aliyun.com/debian\nSuites: %s %s-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n\nTypes: deb\nURIs: https://mirrors.aliyun.com/debian-security\nSuites: %s-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' "$VERSION_CODENAME" "$VERSION_CODENAME" "$VERSION_CODENAME" > /etc/apt/sources.list.d/debian.sources

RUN apt-get -o Acquire::Retries=3 update \
    && apt-get install -y --no-install-recommends \
        curl \
        libonig-dev \
        libpq-dev \
        libsqlite3-dev \
        libzip-dev \
        postgresql-client \
        unzip \
    && docker-php-ext-install \
        mbstring \
        opcache \
        pcntl \
        pdo_pgsql \
        pdo_sqlite \
        zip \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/*

COPY docker/php/opcache.ini /usr/local/etc/php/conf.d/99-opcache.ini
COPY docker/php/php-docker-overrides.ini /usr/local/etc/php/conf.d/99-overrides.ini
COPY docker/php-fpm/www.conf /usr/local/etc/php-fpm.d/zz-geoflow.conf
COPY docker/entrypoint.prod.sh /usr/local/bin/geoflow-entrypoint-prod

RUN chmod +x /usr/local/bin/geoflow-entrypoint-prod

COPY --from=vendor /app /var/www/html
# 注入 Vite 构建产物到 public/build；nginx 镜像可通过 docker build 上下文同步获取
COPY --from=assets /app/public/build /var/www/html/public/build

ENTRYPOINT ["/usr/local/bin/geoflow-entrypoint-prod"]
CMD ["php-fpm", "-F"]
